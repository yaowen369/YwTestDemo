<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#182F3A"
                android:startColor="#081720" />
        </shape>
    </item>
    <item
        android:bottom="26dp"
        android:left="26dp"
        android:right="26dp"
        android:top="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#152933" />
            <stroke
                android:width="1dp"
                android:color="#5B7883" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:width="92dp"
        android:height="92dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FF434D" />
            <stroke
                android:width="5dp"
                android:color="#4A1A22" />
        </shape>
    </item>
</layer-list>
